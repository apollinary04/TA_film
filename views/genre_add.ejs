<!DOCTYPE html>
<html lang="et">
<head><meta charset="utf-8"><title>Lisa žanr</title></head>
<body>
<h1>Lisa žanr</h1>
<a href="/eestifilm">Eesti film</a>
<hr>
<form method="POST">
<label for="genreName">Žanri nimi</label>
<input id="genreName" name="genreName" type="text" placeholder="Žanri nimi" required value="<%= genreName || '' %>">
<br>
<label for="description">Kirjeldus</label>
<textarea id="description" name="description" placeholder="Kirjeldus"><%= description || '' %></textarea>
<br>
<button type="submit">Salvesta</button>
</form>
<hr>
<p><%= notice %></p>
</body>
</html>
