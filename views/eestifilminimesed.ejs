<!DOCTYPE html>
<html lang="et">
<head>
        <meta charset="utf-8">
        <title>Filmiga seotud inimesed</title>
</head>
<body>
        <h1>Filmiga seotud inimesed</h1>
        <a href="/eestifilm">Eesti film</a>
        <br>
        <a href="/eestifilm/inimesed_add">Lisa uus inimene</a>
        <hr>
        <table border="1">
                <tr>
                        <th>Eesnimi</th>
                        <th>Perenimi</th>
                        <th>Sünniaeg</th>
                        <th>Surmaaeg</th>
                </tr>
                <% personList.forEach(function(person){ %>
                <tr>
                        <td><%= person.first_name %></td>
                        <td><%= person.last_name %></td>
                        <td><%= person.birth_date && !isNaN(person.birth_date.getTime()) ? person.birth_date.toLocaleDateString('et-EE') : '' %></td>
                        <td><%= person.death_date && !isNaN(person.death_date.getTime()) ? person.death_date.toLocaleDateString('et-EE') : '' %></td>
                </tr>
                <% }); %>
        </table>
</body>
</html>
