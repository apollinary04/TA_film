<!DOCTYPE html>
<html lang="et">
<head>
        <meta charset="utf-8">
        <title>Lisa uus inimene</title>
</head>
<body>
        <h1>Lisa uus inimene</h1>
        <a href="/eestifilm">Eesti film</a>
        <br>
        <a href="/eestifilm/inimesed">Filmiga seotud inimesed</a>
        <hr>
        <form method="POST">
                <label for="firstNameInput">Eesnimi</label>
                <input id="firstNameInput" name="firstNameInput" type="text" placeholder="Eesnimi" required value="<%= firstNameInput || '' %>">
                <br>
                <label for="lastNameInput">Perenimi</label>
                <input id="lastNameInput" name="lastNameInput" type="text" placeholder="Perenimi" required value="<%= lastNameInput || '' %>">
                <br>
                <label for="bornInput">Sünnikuupäev</label>
                <input id="bornInput" name="bornInput" type="date" required value="<%= bornInput || '' %>">
                <br>
                <label for="deceasedInput">Surmakuupäev</label>
                <input id="deceasedInput" name="deceasedInput" type="date" value="<%= deceasedInput || '' %>">
                <br>
                <button id="personSubmit" name="personSubmit" type="submit">Salvesta</button>
        </form>
        <hr>
        <p><%= notice %></p>
</body>
</html>
